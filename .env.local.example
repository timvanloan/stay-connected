# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional: Cloudflare Turnstile (when Supabase Auth → Attack Protection requires captcha)
# Create a widget at https://dash.cloudflare.com/ → Turnstile → Add site
# Paste the same secret in Supabase → Authentication → Attack Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Required for the account-deletion cron (app/api/cron/purge-deleted-accounts).
# Project Settings → API → service_role key. SERVER-ONLY — never prefix with
# NEXT_PUBLIC_, never expose to the browser, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Required to authenticate Vercel Cron calls to the purge endpoint. Generate a
# random string (e.g. `openssl rand -hex 32`) and set the same value in Vercel
# project env vars — Vercel then sends it automatically as a Bearer token.
CRON_SECRET=

# Public site URL used in Stripe redirect URLs (no trailing slash).
# Production example: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (Dashboard → Developers → API keys + Products → Price ID)
# Publishable key is safe in the browser; secret + webhook secret are server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# When "true", unauthenticated users can still browse; signed-in users without
# an active/trialing subscription are sent to /pricing from /dashboard.
REQUIRE_SUBSCRIPTION=
