# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional: Cloudflare Turnstile (when Supabase Auth → Attack Protection requires captcha)
# Create a widget at https://dash.cloudflare.com/ → Turnstile → Add site
# Paste the same secret in Supabase → Authentication → Attack Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
